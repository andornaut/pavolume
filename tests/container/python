#!/bin/sh
set -eu

python -m venv /scratch/venv
/scratch/venv/bin/python -m pip install --disable-pip-version-check -r requirements-dev.txt
exec /scratch/venv/bin/cppcheck --enable=warning,style,performance,portability \
    --std=c99 --error-exitcode=1 --inline-suppr --check-level=exhaustive \
    --suppressions-list=.cppcheck-suppressions pavolume.c
